# PLANTILLA — NO commitear con valores reales.
#
# Para crear el Secret real en el cluster, ejecutar:
#
#   kubectl create secret generic jwt-secret \
#     --from-literal=JWT_SECRET=$(openssl rand -hex 32)
#
# El valor de JWT_SECRET NUNCA debe aparecer en el repositorio.
# Este archivo es solo documentación del nombre del Secret y la clave.
#
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secret
  labels:
    app: identity-service
type: Opaque
data: {}
# data:
#   JWT_SECRET: <base64 del valor generado — NUNCA commitear este valor>
